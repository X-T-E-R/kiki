<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron renderer/utility processes and ELECTRON_RUN_AS_NODE=1 kiki-server require V8 JIT under Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- V8 writes to executable memory during codegen -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- V8 requires executable page protection disabled under Hardened Runtime -->
  <key>com.apple.security.cs.disable-executable-page-protection</key>
  <true/>

  <!-- Unpacked native addons (.node) may be signed outside our Team -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Preserve user NODE_OPTIONS / DYLD_* runtime configuration -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
