{
  "name": "@kiki/cli",
  "version": "0.1.2",
  "description": "Kiki local agent workspace and shared daemon",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "apps/kimi-code"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "keywords": [
    "kiki",
    "local-first",
    "cli",
    "agent",
    "coding-agent",
    "ai",
    "tui"
  ],
  "bin": {
    "kiki": "dist/main.mjs"
  },
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/tui/theme": "./src/tui/theme/index.ts",
    "#/tui/commands": "./src/tui/commands/index.ts",
    "#/cli/sub/web": "./src/cli/sub/web/index.ts",
    "#/cli/sub/web/*": "./src/cli/sub/web/*.ts",
    "#/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.dist-worker.config.ts && node scripts/copy-native-assets.mjs && node scripts/copy-doc-assets.mjs && node scripts/copy-web-assets.mjs",
    "prebuild": "pnpm -C ../kiki-gui build",
    "catalog:update": "node scripts/update-catalog.mjs --out dist/built-in-catalog.json",
    "smoke": "node scripts/smoke.mjs",
    "build:native:js": "node scripts/native/01-bundle.mjs",
    "build:native:sea": "node scripts/native/build.mjs --profile=local",
    "build:native:release": "node scripts/native/build.mjs --profile=release",
    "package:native": "node scripts/native/package.mjs",
    "produce:native:manifest": "node scripts/native/produce-manifest.mjs",
    "release:native:resolve": "node scripts/native/resolve-release.mjs",
    "test:native:smoke": "node scripts/native/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cli-only": "tsx --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:server": "KIKI_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server": "KIKI_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server:multi": "KIKI_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:server:restart": "node scripts/dev-server-restart.mjs",
    "dev:plugin-marketplace": "node scripts/dev-plugin-marketplace-server.mjs",
    "build:plugin-marketplace": "node scripts/build-plugin-marketplace-cdn.mjs",
    "dev:prod": "node dist/main.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w run build:packages && vitest run",
    "test:fast": "pnpm -w run build:packages && vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "pnpm -w run build:packages && vitest run .integration.",
    "e2e": "pnpm -w run build:packages && KIKI_E2E=1 vitest run test/e2e",
    "e2e:real": "pnpm -w run build:packages && KIKI_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.ts"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@kiki/acp-server": "workspace:^",
    "@kiki/agent-core-v2": "workspace:^",
    "@kiki/kap-server": "workspace:^",
    "@kiki/oauth": "workspace:^",
    "@kiki/node-sdk": "workspace:^",
    "@kiki/minidb": "workspace:^",
    "@kiki/pi-tui": "workspace:^",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.0",
    "@types/yazl": "^2.4.6",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "jimp": "^1.6.1",
    "pathe": "^2.0.3",
    "postject": "1.0.0-alpha.6",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tsx": "^4.21.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@kiki/session-core": "workspace:^",
    "@kiki/klient": "workspace:^",
    "@kiki/protocol": "workspace:^",
    "@kiki/transcript": "workspace:^",
    "ws": "^8.18.0"
  }
}
