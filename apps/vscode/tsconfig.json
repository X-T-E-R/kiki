{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "vscode"],
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
