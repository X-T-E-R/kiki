{
  // Mirror the repo root tsconfig; @kiki/protocol is consumed through
  // source `exports`, so its sources are part of this program too. Only the
  // environment (DOM + vite client types) differs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // `zod` belongs to `@kiki/protocol`, which this program already includes.
    // One test checks a Recipe manifest against the real protocol schema, so
    // the types resolve from the package that owns the dependency rather than
    // from a copy added here.
    "paths": { "zod": ["../../packages/protocol/node_modules/zod"] },
    "noEmit": true
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "../../packages/session-core/src",
    "../../packages/protocol/src",
    "../../packages/transcript/src"
  ]
}
