{
  // Mirror the repo root tsconfig; @moonshot-ai/protocol is consumed through
  // source `exports`, so its sources are part of this program too. Only the
  // environment (DOM + vite client types) differs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "../../packages/session-core/src",
    "../../packages/protocol/src",
    "../../packages/transcript/src"
  ]
}
