{
  "name": "@kiki/gui",
  "version": "0.1.2",
  "private": true,
  "description": "Kiki browser and desktop GUI",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "apps/kiki-gui"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "tauri",
    "desktop:prepare": "node scripts/prepare-sidecar.mjs",
    "desktop:prepare:test": "node --test scripts/prepare-sidecar.test.mjs",
    "desktop:before-dev": "pnpm desktop:prepare && pnpm dev",
    "desktop:before-build": "pnpm build && pnpm desktop:prepare",
    "desktop:dev": "tauri dev",
    "desktop:build:artifacts": "tauri build --no-bundle",
    "desktop:build": "tauri build --bundles nsis",
    "desktop:version:check": "node scripts/desktop-version.mjs check",
    "desktop:version:set": "node scripts/desktop-version.mjs set",
    "desktop:promote:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-release.ps1 -Action Promote",
    "desktop:promote": "pnpm desktop:promote:dev",
    "desktop:shortcuts:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-release.ps1 -Action InstallShortcuts",
    "desktop:shortcuts": "pnpm desktop:shortcuts:dev",
    "desktop:release:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-release.test.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "fixtures": "node scripts/fixture-server.mjs",
    "proof": "node scripts/visual-proof.mjs",
    "proof:update-goldens": "node scripts/visual-proof.mjs --update-goldens",
    "proof:test": "node --test scripts/visual-proof-options.test.mjs scripts/fixture-transcript.test.mjs"
  },
  "dependencies": {
    "@kiki/agent-profiles": "workspace:^",
    "@kiki/session-core": "workspace:^",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "@kiki/klient": "workspace:^",
    "@kiki/protocol": "workspace:^",
    "@kiki/transcript": "workspace:^",
    "@streamdown/code": "^1.0.2",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.1",
    "streamdown": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.8.4",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright": "1.60.0",
    "tailwindcss": "^4.1.4",
    "typescript": "6.0.2",
    "vite": "^6.3.3",
    "vitest": "4.1.4",
    "ws": "^8.18.0"
  }
}
