{
  "appId": "ai.easyagent.kiki",
  "appName": "Kiki",
  "webDir": "launcher",
  "backgroundColor": "#fbfaf6",
  "server": {
    "androidScheme": "https",
    "errorPath": "index.html#unreachable"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "appendUserAgent": "KikiApp/android"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "appendUserAgent": "KikiApp/ios"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
