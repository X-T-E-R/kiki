{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiki",
  "version": "0.1.0-beta.1",
  "identifier": "ai.easyagent.kiki",
  "build": {
    "beforeDevCommand": "pnpm desktop:before-dev",
    "devUrl": "http://127.0.0.1:5177",
    "beforeBuildCommand": "pnpm desktop:before-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiki",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "externalBin": ["binaries/kiki-server"],
    "resources": ["../THIRD_PARTY_NOTICES.md"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzREYxRTFGNUFERUU1MzgKUldRNDVkNWFIeDdmWTE2UHhSQmluQXVDOXRPS2xxaTFvdm1WVWNDUmhvd29MUjI2dHFZK0FZd2YK",
      "endpoints": [
        "https://x-t-e-r.github.io/kiki/updater/stable/latest.json",
        "https://x-t-e-r.github.io/kiki/updater/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
