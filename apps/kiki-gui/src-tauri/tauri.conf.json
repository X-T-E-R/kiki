{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiki",
  "mainBinaryName": "kiki-desktop",
  "version": "0.3.1",
  "identifier": "ai.easyagent.kiki",
  "build": {
    "beforeDevCommand": "pnpm desktop:before-dev",
    "devUrl": "http://127.0.0.1:5177",
    "beforeBuildCommand": "pnpm desktop:before-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kiki",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; img-src 'self' asset: data: blob:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "dmg"
    ],
    "externalBin": [
      "binaries/kiki-server"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "linux": {
      "deb": {
        "postInstallScript": "./linux/postinst.sh",
        "postRemoveScript": "./linux/postrm.sh"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/cli-path.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzREYxRTFGNUFERUU1MzgKUldRNDVkNWFIeDdmWTE2UHhSQmluQXVDOXRPS2xxaTFvdm1WVWNDUmhvd29MUjI2dHFZK0FZd2YK",
      "endpoints": [
        "https://x-t-e-r.github.io/kiki/updater/stable/latest.json",
        "https://x-t-e-r.github.io/kiki/updater/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
