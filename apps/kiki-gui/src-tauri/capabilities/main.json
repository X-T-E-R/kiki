{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Kiki desktop window: window management, tray, notifications, shell sidecar, native dialogs, and scoped file access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-overlay-icon",
    "core:webview:allow-set-webview-zoom",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-desktop-connection",
    "allow-desktop-active-space",
    "allow-desktop-space-statuses",
    "allow-set-unread-count",
    "allow-switch-space",
    "allow-restart-space",
    "allow-open-space",
    "allow-create-space-shortcut",
    "allow-list-ssh-profiles",
    "allow-save-ssh-profile",
    "allow-remove-ssh-profile",
    "allow-connect-ssh-profile",
    "allow-ssh-tunnel-running",
    "allow-disconnect-ssh-profile",
    "allow-cancel-desktop-startup",
    "allow-show-main-window",
    "allow-send-desktop-notification",
    "allow-write-host-file-text",
    "allow-reveal-host-path",
    "allow-open-host-path",
    "allow-open-external-url",
    "allow-read-desktop-prefs",
    "allow-write-desktop-prefs",
    "allow-desktop-log-info",
    "allow-open-desktop-log-directory",
    "allow-supports-desktop-updates",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "allow-prepare-for-update",
    "allow-restart-server",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    }
  ]
}
