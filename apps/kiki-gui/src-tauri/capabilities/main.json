{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Kiki desktop window: window management, tray, notifications, shell sidecar, native dialogs, and scoped file access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-desktop-connection",
    "allow-cancel-desktop-startup",
    "allow-show-main-window",
    "allow-write-host-file-text",
    "allow-read-desktop-prefs",
    "allow-read-kimi-home-paths",
    "allow-write-desktop-prefs",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "allow-prepare-for-update",
    "allow-import-kimi-config",
    "allow-migrate-compatibility-category",
    "allow-dry-run-sessions-migration",
    "allow-execute-sessions-migration",
    "allow-restart-server",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    }
  ]
}
