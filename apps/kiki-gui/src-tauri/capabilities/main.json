{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Kiki desktop window: window management, tray, notifications, shell sidecar, native save dialog, and file writes for session export.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
