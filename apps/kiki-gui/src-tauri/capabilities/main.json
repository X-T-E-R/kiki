{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Kiki desktop window: window management, tray, notifications, shell sidecar, native dialogs, and scoped file access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        "$APPCONFIG",
        "$APPCONFIG/**",
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    }
  ]
}
