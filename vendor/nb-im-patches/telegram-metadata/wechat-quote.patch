+    await adapter.start({ async admit(event) { events.push(event); return { decision: 'accepted' }; } });
+    for (let i = 0; i < 40 && adapter.state !== 'auth_expired'; i += 1) await new Promise((resolve) => setTimeout(resolve, 5));
