+      if (request.method === 'getWebhookInfo') return { http_status: 200, body: { ok: true, result: { url: '' } } };
+      if (request.method === 'getUpdates') {
+        page += 1;
+        if (page === 1) {
+          return {
+            http_status: 200,
+            body: {
+              ok: true,
+              result: [
