+class SequentialTransport implements JsonTransport {
+  readonly requests: JsonRequest[] = [];
+  constructor(private readonly responses: readonly JsonResponse[]) {}
+  async send<T>(requestValue: JsonRequest): Promise<JsonResponse<T>> {
+    this.requests.push(requestValue);
+    const response = this.responses[Math.min(this.requests.length - 1, this.responses.length - 1)];
+    if (response === undefined) throw new Error('SequentialTransport ran out of responses.');
+    return response as JsonResponse<T>;
+  }
