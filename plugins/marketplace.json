      "keywords": ["browser", "automation", "webbridge"],
      "source": "./official/kimi-webbridge"
    },
    {
      "id": "kiki-office",
      "tier": "official",
      "displayName": "Kiki Office Suite",
      "version": "0.1.0",
      "description": "Create and edit local Word, Excel and PowerPoint files.",
      "keywords": ["office", "docx", "xlsx", "pptx"],
      "relevance": { "fileGlobs": ["**/*.docx", "**/*.xlsx", "**/*.pptx"], "commands": ["officecli"] },
      "source": "./official/kiki-office"
    },
    {
      "id": "kiki-writing",
      "tier": "official",
      "displayName": "Kiki Writing",
      "version": "0.1.0",
      "description": "A focused manuscript panel and draft command.",
      "keywords": ["writing", "manuscript", "fiction"],
      "relevance": { "fileGlobs": ["**/*.md", "**/*.txt"] },
      "source": "./official/kiki-writing"
    },
    {
      "id": "superpowers",
      "tier": "curated",
      "displayName": "Superpowers",
      "description": "Planning, TDD, debugging, and delivery workflows for coding agents.",
      "homepage": "https://github.com/obra/superpowers",
      "keywords": ["skills", "planning", "tdd", "debugging", "code-review"],
      "source": "https://github.com/obra/superpowers"
    },
    {
      "id": "vercel-plugin",
      "tier": "curated",
