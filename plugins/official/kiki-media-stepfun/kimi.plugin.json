{
  "name": "kiki-media-stepfun", "version": "0.1.0", "description": "StepFun HTTP binary/SSE file speech. Trusted Node HTTP adaptation, not an Android SDK or WebSocket live-session runtime.", "license": "MIT AND Apache-2.0",
  "interface": { "displayName": "StepFun Speech", "shortDescription": "Chinese/multilingual HTTP speech" },
  "x-kiki": {
    "engines": { "kiki": "^0.4.0" }, "entry": "./entry.mjs", "permissions": { "fs": "outside", "net": ["*"], "secrets": true },
    "settings": { "schemaVersion": 1, "schema": { "type": "object", "required": ["apiKey"], "properties": {
      "connectionId": { "type": "string", "title": "Kiki StepFun connection (optional)", "description": "Selected StepFun API endpoint and authentication replace this plugin's key; choose an endpoint with TTS entitlement." },
      "apiKey": { "type": "string", "title": "API key", "secret": true }, "baseUrl": { "type": "string", "title": "API base URL", "default": "https://api.stepfun.ai/v1" }, "speechModel": { "type": "string", "title": "Default speech model", "default": "stepaudio-3-tts" }
    } } },
    "mediaProviders": [{ "schemaVersion": 1, "id": "speech", "label": "StepFun Speech", "kinds": ["tts"], "resumeVersion": 1, "connectionSetting": "connectionId" }]
  }
}
