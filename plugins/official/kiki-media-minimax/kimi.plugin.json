{
  "name": "kiki-media-minimax", "version": "0.1.0", "description": "MiniMax portrait-reference images, H3/H3-Max video and HTTP/SSE file speech with optional subtitles. No CLI/OAuth/runtime dependency or implicit long-text paid splitting.", "license": "MIT",
  "interface": { "displayName": "MiniMax Media", "shortDescription": "Images, H3 video and speech/subtitles" },
  "x-kiki": {
    "engines": { "kiki": "^0.4.0" }, "entry": "./entry.mjs", "permissions": { "fs": "outside", "net": ["*"], "secrets": true },
    "settings": { "schemaVersion": 1, "schema": { "type": "object", "required": ["apiKey"], "properties": {
      "connectionId": { "type": "string", "title": "Kiki MiniMax connection (optional)", "description": "Selected MiniMax API authentication replaces this plugin's key. Media requires corresponding pay-as-you-go entitlement; text Token Plan/OAuth does not imply it." },
      "apiKey": { "type": "string", "title": "API key", "secret": true }, "baseUrl": { "type": "string", "title": "API base URL (no /v1 or /v2 suffix)", "default": "https://api.minimax.io" },
      "imageModel": { "type": "string", "title": "Default image model", "default": "image-01" }, "videoModel": { "type": "string", "title": "Default video model", "default": "MiniMax-H3" }, "speechModel": { "type": "string", "title": "Default speech model", "default": "speech-2.8-hd" }
    } } },
    "mediaProviders": [{ "schemaVersion": 1, "id": "image", "label": "MiniMax Images", "kinds": ["image"], "resumeVersion": 1, "connectionSetting": "connectionId" }, { "schemaVersion": 1, "id": "video", "label": "MiniMax H3 Video", "kinds": ["video"], "resumeVersion": 1, "connectionSetting": "connectionId" }, { "schemaVersion": 1, "id": "speech", "label": "MiniMax Speech", "kinds": ["tts"], "resumeVersion": 1, "connectionSetting": "connectionId" }]
  }
}
