{
  "name": "kiki-media-google", "version": "0.1.0", "description": "Google Gemini native images and Veo asynchronous video. Trusted Node HTTP adapters; generated originals are saved as files.", "license": "MIT",
  "interface": { "displayName": "Google Media", "shortDescription": "Gemini images and Veo video" },
  "x-kiki": {
    "engines": { "kiki": "^0.4.0" }, "entry": "./entry.mjs", "permissions": { "fs": "outside", "net": ["*"], "secrets": true },
    "settings": { "schemaVersion": 1, "schema": { "type": "object", "required": ["apiKey"], "properties": {
      "connectionId": { "type": "string", "title": "Kiki Google connection (optional)", "description": "Use a Gemini API endpoint with x-goog-api-key authentication. Other OAuth products are not assumed compatible." },
      "apiKey": { "type": "string", "title": "API key", "secret": true }, "baseUrl": { "type": "string", "title": "API base URL", "default": "https://generativelanguage.googleapis.com/v1beta" },
      "imageModel": { "type": "string", "title": "Default image model", "default": "gemini-2.5-flash-image" }, "videoModel": { "type": "string", "title": "Default Veo model", "default": "veo-3.1-generate-preview" }
    } } },
    "mediaProviders": [{ "schemaVersion": 1, "id": "image", "label": "Gemini Images", "kinds": ["image"], "resumeVersion": 1, "connectionSetting": "connectionId" }, { "schemaVersion": 1, "id": "video", "label": "Veo Video", "kinds": ["video"], "resumeVersion": 1, "connectionSetting": "connectionId" }]
  }
}
