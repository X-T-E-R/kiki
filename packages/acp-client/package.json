{
  "name": "@moonshot-ai/acp-client",
  "version": "0.0.1",
  "private": true,
  "description": "Outbound Agent Client Protocol process and session engine",
  "license": "MIT",
  "author": "Moonshot AI",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "zod": "catalog:"
  }
}
