{
  "name": "@kiki/acp-client",
  "version": "0.0.2",
  "private": true,
  "description": "Outbound Agent Client Protocol process and session engine",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "packages/acp-client"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "license": "MIT",
