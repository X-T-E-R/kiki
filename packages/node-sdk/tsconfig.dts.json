{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".tmp-api-extractor/dts",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../agent-core-v2/src/**/*.ts",
    "../agent-profiles/src/**/*.ts",
    "../acp-client/src/**/*.ts",
    "../codex-client/src/**/*.ts",
    "../kaos/src/**/*.ts",
    "../klient/src/**/*.ts",
    "../oauth/src/**/*.ts",
    "../protocol/src/**/*.ts",
    "../transcript/src/**/*.ts"
  ],
  "exclude": ["dist", ".tmp-api-extractor", "examples", "test", "../*/dist", "../*/test"]
}
