{
  "name": "@kiki/node-sdk",
  "version": "0.19.0",
  "private": true,
  "description": "TypeScript SDK for the Kiki Agent",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "keywords": [
    "kiki",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/config": "./src/config/index.ts",
    "#/errors": "./src/errors/index.ts",
    "#/logging": "./src/logging/index.ts",
    "#/protocol": "./src/protocol/index.ts",
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wire": {
      "types": "./src/wire/records.ts",
      "default": "./src/wire/records.ts"
    },
    "./native-fs-watch-error-guard": {
      "types": "./src/native-fs-watch-error-guard.ts",
      "default": "./src/native-fs-watch-error-guard.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./native-fs-watch-error-guard": {
        "types": "./dist/native-fs-watch-error-guard.d.mts",
        "import": "./dist/native-fs-watch-error-guard.mjs",
        "default": "./dist/native-fs-watch-error-guard.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.native-fs-watch-error-guard.config.ts && pnpm run build:dts",
    "build:dts": "node scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@nb-corp/nb-search": "file:../../vendor/nb-search-0.4.0-22c490b8.tgz",
    "own-work": "file:../../vendor/own-work-0.1.1-kiki-7a5fb754.tgz",
    "pathe": "^2.0.3",
    "smol-toml": "^1.6.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kiki/agent-core-v2": "workspace:^",
    "@kiki/protocol": "workspace:^",
    "@kiki/kaos": "workspace:^",
    "@kiki/oauth": "workspace:^",
    "@kiki/klient": "workspace:^",
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  }
}
