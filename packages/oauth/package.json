{
  "name": "@kiki/oauth",
  "version": "0.4.0",
  "private": true,
  "description": "Kimi OAuth toolkit for managed Kimi Code authentication",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "keywords": [
    "kimi",
    "oauth",
    "authentication",
    "auth",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./device": {
      "types": "./src/device.ts",
      "default": "./src/device.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
