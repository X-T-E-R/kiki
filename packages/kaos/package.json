{
  "name": "@kiki/kaos",
  "version": "0.1.6",
  "private": true,
  "description": "Execution environment abstraction for AI agent applications",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "packages/kaos"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "keywords": [
    "kiki",
    "agent",
    "execution",
    "sandbox",
    "process",
    "filesystem"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./atomic-fs": {
      "types": "./src/atomic-fs.ts",
      "default": "./src/atomic-fs.ts"
    },
    "./exec-env": {
      "types": "./src/exec-env.ts",
      "default": "./src/exec-env.ts"
    },
    "./ssh": {
      "types": "./src/ssh.ts",
      "default": "./src/ssh.ts"
    },
    "./ssh-connection": {
      "types": "./src/ssh-connection.ts",
      "default": "./src/ssh-connection.ts"
    },
    "./space-home": {
      "types": "./src/space-home.ts",
      "default": "./src/space-home.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kiki/protocol": "workspace:^",
    "@kiki/shell-quoting": "workspace:^",
    "lru-cache": "^11.3.3",
    "pathe": "^2.0.3",
    "smol-toml": "^1.9.0",
    "ssh2": "^1.17.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5"
  }
}
