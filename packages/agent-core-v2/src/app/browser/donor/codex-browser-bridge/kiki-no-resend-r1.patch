+    #[tokio::test]
+    async fn response_channel_close_after_write_is_not_resent() {
+        let (client_end, mut server) = duplex(4096);
+        let call_count = Arc::new(AtomicUsize::new(0));
+        let factory: ConnectionFactory = {
+            let call_count = Arc::clone(&call_count);
+            Arc::new(move || {
+                let call_count = Arc::clone(&call_count);
+                Box::pin(async move {
+                    call_count.fetch_add(1, Ordering::SeqCst);
+                    let (client, _server) = duplex(4096);
+                    Ok(client)
+                })
+            })
+        };
+        let client = Client::from_stream_with_factory(client_end, factory).unwrap();
+        let task = tokio::spawn({
+            let client = client.clone();
+            async move { client.send_request("click", None).await }
+        });
+        let req = next_request(&mut server).await;
+        assert_eq!(req["method"], "click");
+        server.shutdown().await.ok();
+        drop(server);
+        let err = task.await.unwrap().unwrap_err();
+        assert!(
+            matches!(err, BridgeError::Connection(message) if message.starts_with("response channel closed")),
+            "got: {err}"
+        );
+        assert_eq!(call_count.load(Ordering::SeqCst), 0);
+    }
