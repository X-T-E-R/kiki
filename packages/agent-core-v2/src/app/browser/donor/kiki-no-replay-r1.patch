+#[cfg(windows)]
+fn read_cli_output(mut reader: impl Read + std::os::windows::io::AsRawHandle, exited: std::sync::Arc<std::sync::atomic::AtomicBool>) -> io::Result<Vec<u8>> {
+    use std::sync::atomic::Ordering;
+    use windows_sys::Win32::System::Pipes::PeekNamedPipe;
+    let mut bytes = Vec::new();
+    let mut buffer = [0u8; 8192];
+    loop {
+        let mut available = 0u32;
+        let ok = unsafe { PeekNamedPipe(reader.as_raw_handle() as isize, std::ptr::null_mut(), 0, std::ptr::null_mut(), &mut available, std::ptr::null_mut()) };
+        if ok == 0 {
+            let error = io::Error::last_os_error();
+            if matches!(error.raw_os_error(), Some(109) | Some(232)) { break; }
+            return Err(error);
+        }
+        if available > 0 {
+            let count = reader.read(&mut buffer[..(available as usize).min(8192)])?;
+            if count == 0 { break; }
+            if bytes.len() + count > 64 * 1024 * 1024 { return Err(io::Error::other("CLI output exceeds the 64 MiB capture limit; outcome is unknown")); }
+            bytes.extend_from_slice(&buffer[..count]);
+        } else if exited.load(Ordering::Acquire) {
+            break;
+        } else {
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+    Ok(bytes)
+}
