{
  "name": "fixture-asr",
  "version": "1.0.0",
  "x-kiki": {
    "engines": { "kiki": "^0.4.0" },
    "entry": "./entry.mjs",
    "permissions": { "secrets": true },
    "asrProviders": [
      { "id": "speech", "label": "Speech", "description": "Fixture speech recognition", "connectionSetting": "connectionId" },
      { "id": "alternate", "label": "Alternate" }
    ],
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "connectionId": { "type": "string", "title": "Kiki connection (optional)" },
          "providerToken": { "type": "string", "secret": true }
        }
      }
    }
  }
}
