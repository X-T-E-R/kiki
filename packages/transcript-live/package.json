{
  "name": "@kiki/transcript-live",
  "version": "0.0.1",
  "private": true,
  "description": "Engine event bindings for the canonical transcript operation stream.",
  "homepage": "https://github.com/X-T-E-R/kiki/releases",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-T-E-R/kiki.git",
    "directory": "packages/transcript-live"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/kiki/issues"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kiki/agent-core-v2": "workspace:^",
    "@kiki/protocol": "workspace:^",
    "@kiki/transcript": "workspace:^"
  },
  "devDependencies": {
    "@kiki/session-core": "workspace:^"
  }
}
