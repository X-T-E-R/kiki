{
  "name": "@moonshot-ai/kap-server",
  "version": "0.2.2",
  "private": true,
  "description": "Kimi Code server backed by the DI × Scope agent engine (agent-core-v2)",
  "type": "module",
  "bin": {
    "kiki-mcp": "dist/mcp/stdio.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./search-worker-runtime": {
      "types": "./src/search/worker/runtime.ts",
      "default": "./src/search/worker/runtime.ts"
    },
    "./model-pricing-runtime": {
      "types": "./src/pricing/runtime.ts",
      "default": "./src/pricing/runtime.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "bench": "vitest run --config vitest.bench.config.ts",
    "model-prices:update": "node scripts/update-model-prices.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.integration.ts\" --exclude \"**/*.e2e.ts\"",
    "test:integration": "vitest run .integration.",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@kiki/transcript-live": "workspace:^",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/minidb": "workspace:*",
    "@moonshot-ai/protocol": "workspace:^",
    "@moonshot-ai/transcript": "workspace:^",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "ulid": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0"
  }
}
